# === Local / Render .env ===
# Do NOT commit real secrets.

# Optional — AI insight sections
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=8787

# Dashboard extension mode needs NO Tableau PAT.
# On each dashboard the extension reads session datasource data and
# POSTs to /api/narrative on your hosted URL (e.g. Render).
#
# TABLEAU_PAT_* is only for optional browser tests (?contentUrl=...) — leave unset.
