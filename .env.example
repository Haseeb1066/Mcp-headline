# === Local development (.env) ===
# Copy to .env for local runs. Do NOT commit .env.

# Optional — AI insight sections / polished summary
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local only — NOT needed on Render for dashboard extension mode
# (PAT is only for browser tests like ?contentUrl=...)
# TABLEAU_SERVER=
# TABLEAU_SITE_NAME=
# TABLEAU_PAT_NAME=
# TABLEAU_PAT_VALUE=
# TABLEAU_SSL_VERIFY=0
# NODE_TLS_REJECT_UNAUTHORIZED=0

PORT=8787

# === What to set on Render (Environment tab) ===
# Required by Render automatically: PORT (do not set yourself)
# Optional:
#   OPENAI_API_KEY   = your OpenAI key (same value as local if you want AI insights)
#   OPENAI_MODEL     = gpt-4o-mini
# Do NOT set on Render for dashboard mode:
#   TABLEAU_SERVER, TABLEAU_SITE_NAME, TABLEAU_PAT_NAME, TABLEAU_PAT_VALUE
#   TABLEAU_CONNECTED_APP_*, TABLEAU_JWT_*, TABLEAU_CHAT_MODE
