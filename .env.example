# Narrative Insights — copy to .env (do not commit secrets)

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8787

# --- Tableau access (optional for dashboard extension session mode) ---
TABLEAU_SERVER=https://your-tableau-server
# Site contentUrl (empty = default site)
TABLEAU_SITE_NAME=
TABLEAU_SSL_VERIFY=1

# Preferred: Connected App (direct trust) for REST API access
TABLEAU_CONNECTED_APP_CLIENT_ID=
TABLEAU_CONNECTED_APP_SECRET_ID=
TABLEAU_CONNECTED_APP_SECRET=
# Tableau username / email the JWT acts as
TABLEAU_JWT_SUB_CLAIM=

# Optional PAT fallback (needed for MCP query-datasource / get-view-data)
# TABLEAU_PAT_NAME=
# TABLEAU_PAT_VALUE=

# Dashboard extension: no Tableau server creds required — reads session datasource.
