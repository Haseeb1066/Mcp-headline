<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.narrative.insights" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description resource-id="description"/>
    <author name="Narrative Insights" website="https://mcp-headline.onrender.com/"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>https://mcp-headline.onrender.com/</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Narrative Insights</text>
    </resource>
    <resource id="description">
      <text locale="en_US">Summary, highlights, and MoM/YoY comparisons from this dashboard’s data.</text>
    </resource>
  </resources>
</manifest>
